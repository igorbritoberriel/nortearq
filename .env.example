# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do site (usado nos links enviados ao cliente)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave secreta do Supabase (Project Settings > API Keys > "Secret key" ou "service_role").
# Só o servidor usa: envio de fotos do briefing e avisos por e-mail. NUNCA coloque NEXT_PUBLIC_ nela.
SUPABASE_SECRET_KEY=

# Avisos por e-mail (https://resend.com > API Keys). Sem a chave, os avisos só aparecem no terminal.
RESEND_API_KEY=
# Remetente. Para testar, use "NorteArq <onboarding@resend.dev>" (só entrega no e-mail da sua conta Resend).
# Em produção, verifique o domínio no Resend e use, por exemplo, "NorteArq <avisos@nortearq.com.br>".
EMAIL_REMETENTE=NorteArq <onboarding@resend.dev>
